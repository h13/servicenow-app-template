{
  "name": "servicenow-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth": "now-sdk auth",
    "build": "now-sdk build",
    "build:ci": "now-sdk build --frozenKeys",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "now-sdk clean",
    "dependencies": "now-sdk dependencies",
    "deploy": "pnpm run build && pnpm run install:instance",
    "download": "now-sdk download .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "install:instance": "now-sdk install",
    "lint": "oxlint --fix src test examples",
    "pack": "now-sdk pack",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "transform": "now-sdk transform --from .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@servicenow/sdk": "4.9.0",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=22"
  }
}
