{
  "name": "servicenow-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth": "now-sdk auth",
    "build": "now-sdk build",
    "build:ci": "now-sdk build --frozenKeys",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "now-sdk clean",
    "dependencies": "now-sdk dependencies",
    "deploy": "pnpm run build && pnpm run install:instance",
    "download": "now-sdk download .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "install:instance": "now-sdk install",
    "lint": "oxlint --fix src test examples",
    "pack": "now-sdk pack",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "transform": "now-sdk transform --from .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@servicenow/sdk": "4.9.0",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=22"
  }
}
