{
  "name": "servicenow-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth": "now-sdk auth",
    "build": "now-sdk build",
    "build:ci": "now-sdk build --frozenKeys",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "now-sdk clean",
    "dependencies": "now-sdk dependencies",
    "deploy": "pnpm run build && pnpm run install:instance",
    "download": "now-sdk download .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "install:instance": "now-sdk install",
    "lint": "oxlint --fix src test examples",
    "pack": "now-sdk pack",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "transform": "now-sdk transform --from .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@servicenow/sdk": "4.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=22"
  }
}
