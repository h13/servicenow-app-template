{
  "name": "servicenow-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth": "now-sdk auth",
    "build": "now-sdk build",
    "build:ci": "now-sdk build --frozenKeys",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "now-sdk clean",
    "dependencies": "now-sdk dependencies",
    "deploy": "pnpm run build && pnpm run install:instance",
    "download": "now-sdk download .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "install:instance": "now-sdk install",
    "lint": "oxlint --fix src test examples",
    "pack": "now-sdk pack",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "transform": "now-sdk transform --from .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@servicenow/sdk": "4.14.2",
    "@vitest/coverage-v8": "5.1.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
